# Configuración del entorno local. Las claves quedan vacías intencionalmente.
# scripts/iniciar.mjs genera un .env ignorado con claves aleatorias una sola vez.
# Conservar ese .env mientras se utilicen los mismos volúmenes de bases/broker.
# Las claves generadas son hexadecimales, compatibles con las URLs de conexión.
GATEWAY_PORT=8080
POSTGRES_ADMIN_PASSWORD=
SOCIOS_DB_PASSWORD=
CLASES_DB_PASSWORD=
TIENDA_DB_PASSWORD=
MONGO_ROOT_PASSWORD=
ACCESOS_DB_PASSWORD=
MONGO_KEYFILE=
RABBITMQ_PASSWORD=
CAPACIDAD_API_KEY=
# Sesiones del portal y comunicación interna; distintas de la clave externa.
AUTH_JWT_SECRET=
SERVICIOS_API_KEY=
AUTH_JWT_TTL_SECONDS=3600
RESERVAS_REINTENTO_MS=5000
# Integración de empleados: origen ficticio local, no identifica al grupo real.
# Conservar el origen y la clave al reiniciar para recuperar la idempotencia.
EMPLEADOS_API_KEY=
EMPLEADOS_ORIGEN_ID=grupo-ficticio-local
# Credencial que el gimnasio entrega a FAV por privado para stock y reposiciones.
# El inicio genera una clave local ausente; no es el token del catálogo de FAV.
FAV_API_KEY=
# Catálogo de FAV consumido por Tienda (contrato catalogo-pedidos 1.2.0, header X-API-Key).
# URL y clave las entrega FAV por privado. Vacías: el catálogo responde 503 PROVEEDOR_NO_CONFIGURADO.
# Con el mock local (npm run mock:fav): http://host.docker.internal:8090 y clave-fav-local.
# FAV_CATALOGO_BASE_URL=https://fav-ucc.chilecentral.cloudapp.azure.com
FAV_CATALOGO_BASE_URL=
FAV_CATALOGO_API_KEY=
FAV_CATALOGO_TIMEOUT_MS=3000
# Lecturas de Car Cruds: completar ambos con datos entregados por el grupo.
# El token es de aplicación (rol gym); no es el JWT del gimnasio y no se genera.
# Dejar URL y token vacíos mantiene la integración pendiente sin impedir el portal.
CAR_CRUDS_BASE_URL=
CAR_CRUDS_TOKEN=
CAR_CRUDS_TIMEOUT_MS=3000
# Contraseña del usuario admin de Grafana (el inicio la genera si falta). El tablero es visible sin login.
GRAFANA_ADMIN_PASSWORD=
# Despliegue en VM (docs/DEPLOY.md): dominio público servido por Caddy con HTTPS.
# scripts/desplegar-vm.sh lo calcula como gimnasio.<ip-con-guiones>.sslip.io. No se usa en local.
DOMINIO=
