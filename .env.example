# Configuración del entorno local. Las claves quedan vacías intencionalmente.
# scripts/iniciar.mjs genera un .env ignorado con claves aleatorias una sola vez.
# Conservar ese .env mientras se utilicen los mismos volúmenes de bases/broker.
# Las claves generadas son hexadecimales, compatibles con las URLs de conexión.
GATEWAY_PORT=8080
POSTGRES_ADMIN_PASSWORD=
SOCIOS_DB_PASSWORD=
CLASES_DB_PASSWORD=
MONGO_ROOT_PASSWORD=
ACCESOS_DB_PASSWORD=
MONGO_KEYFILE=
RABBITMQ_PASSWORD=
CAPACIDAD_API_KEY=
# Sesiones del portal y comunicación interna; distintas de la clave externa.
AUTH_JWT_SECRET=
SERVICIOS_API_KEY=
AUTH_JWT_TTL_SECONDS=3600
RESERVAS_REINTENTO_MS=5000
# Integración de empleados: origen ficticio local, no identifica al grupo real.
# Conservar el origen y la clave al reiniciar para recuperar la idempotencia.
EMPLEADOS_API_KEY=
EMPLEADOS_ORIGEN_ID=grupo-ficticio-local
# Lecturas de Car Cruds: completar ambos con datos entregados por el grupo.
# El token es de aplicación (rol gym); no es el JWT del gimnasio y no se genera.
# Dejar URL y token vacíos mantiene la integración pendiente sin impedir el portal.
CAR_CRUDS_BASE_URL=
CAR_CRUDS_TOKEN=
CAR_CRUDS_TIMEOUT_MS=3000
