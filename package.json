{
  "name": "gestion-gimnasio",
  "version": "0.1.0",
  "private": true,
  "engines": { "node": ">=22 <23" },
  "workspaces": [
    "services/socios-membresias",
    "services/clases-reservas",
    "services/accesos-ocupacion",
    "services/tienda"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "test": "npm run build && node --test",
    "test:contrato-empleados": "npm run build --workspace=@gimnasio/socios-membresias && node --test services/socios-membresias/test/empleados-contract.test.mjs",
    "test:car-cruds": "npm run build --workspace=@gimnasio/socios-membresias && node --test services/socios-membresias/test/car-cruds-client.test.mjs services/socios-membresias/test/car-cruds-http.test.mjs services/socios-membresias/test/car-cruds-vinculos.test.mjs services/socios-membresias/test/car-cruds-evidence-client.test.mjs services/socios-membresias/test/car-cruds-evidencias.test.mjs services/socios-membresias/test/car-cruds-campos.test.mjs",
    "mock:fav": "node scripts/mock-fav.mjs",
    "mock:empleados": "npm run build --workspace=@gimnasio/socios-membresias && node services/socios-membresias/dist/empleados.mock.js",
    "crear-admin": "node scripts/crear-admin.mjs",
    "test:frontend": "node --test frontend/src/services/api.test.mjs frontend/src/components/MembresiasPanel.test.mjs",
    "test:postgres": "npm run build && node scripts/verificar-postgres.mjs",
    "test:balanceo": "node scripts/verificar-balanceo.mjs",
    "test:accesos": "npm run build && node --test scripts/verificar-accesos.mjs",
    "test:membresias": "npm run build && node --test scripts/verificar-membresias.mjs",
    "test:cache": "npm run build && node --test scripts/verificar-cache-ocupacion.mjs",
    "test:tienda": "npm run build && node --test --test-concurrency=1 scripts/verificar-tienda.mjs scripts/verificar-compras-tienda.mjs",
    "test:eventos": "npm run build && node --test scripts/verificar-eventos-membresia.mjs",
    "test:cobertura": "npm run build && node --test --experimental-test-coverage --test-coverage-exclude=**/test/** --test-coverage-exclude=scripts/** --test-coverage-exclude=frontend/** --test-coverage-lines=70 --test-coverage-branches=80 --test-coverage-functions=80",
    "simulacro:fav": "node scripts/simulacro-fav.mjs",
    "test:carga": "node scripts/test-carga.mjs",
    "test:busqueda": "npm run build && node --test scripts/verificar-busqueda.mjs",
    "test:gestion-clases": "npm run build && node --test scripts/verificar-gestion-clases.mjs",
    "frontend:dev": "npm --prefix frontend run dev",
    "frontend:build": "npm --prefix frontend run build",
    "iniciar": "node scripts/iniciar.mjs"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3"
  }
}
